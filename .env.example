# ==============================================================================
# AI Business Operations Platform - Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="AI Business Operations Platform"
VERSION=1.0.0
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET=supersecret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for easy local setup, or PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_business_ops
DATABASE_URL=sqlite:///./ai_business_ops.db

# Cache / Queue (Optional Redis)
REDIS_URL=redis://localhost:6379/0

# AI / LLM Configuration
# Set to 'gemini' for real Gemini API or 'mock' for realistic offline demonstration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
